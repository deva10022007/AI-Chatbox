import getpass
import os
from groq import Groq

# 2. Securely prompt for the API key if not already set in environment
api_key = os.environ.get("GROQ_API_KEY")
if not api_key:
    # Check if stored in Google Colab Secrets (userdata)
    try:
        from google.colab import userdata
        api_key = userdata.get("GROQ_API_KEY")
    except Exception:
        pass

if not api_key:
    api_key = getpass.getpass("Enter your Groq API Key: ")

# 3. Initialize the Groq client
client = Groq(api_key=api_key)

# 4. Set up an interactive chat loop with streaming
print("\n--- Groq Chat Initialized (Type 'exit' or 'quit' to stop) ---\n")

conversation_history = [
    {"role": "system", "content": "You are a helpful and concise AI assistant."}
]

# Model to use
MODEL_NAME = "llama-3.3-70b-versatile"

while True:
    try:
        user_input = input("\nYou: ")
    except EOFError:
        break

    if user_input.strip().lower() in ["exit", "quit", "q"]:
        print("Ending session.")
        break
    if not user_input.strip():
        continue

    # Add user message to history
    conversation_history.append({"role": "user", "content": user_input})

    print("\nAssistant: ", end="", flush=True)

    # Stream response from Groq
    try:
        completion = client.chat.completions.create(
            model=MODEL_NAME,
            messages=conversation_history,
            temperature=0.7,
            max_completion_tokens=1024,
            stream=True,
        )

        full_response = ""
        for chunk in completion:
            delta = chunk.choices[0].delta.content or ""
            print(delta, end="", flush=True)
            full_response += delta

        print()  # Newline after stream completes

        # Save assistant reply to maintain context
        conversation_history.append({"role": "assistant", "content": full_response})

    except Exception as e:
        print(f"\n[Error]: {e}")
